#!/bin/bash
# Entry point: runs the PlatformGen installer UI without typing python3 explicitly.
set -euo pipefail
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
mkdir -p "$HOME/.platformgen"
echo "Opening PlatformGen installer..."
echo "  (This window will appear on your desktop — your terminal is free to use)"
nohup python3 "$SCRIPT_DIR/install_wizard.py" "$@" </dev/null >"$HOME/.platformgen/install_wizard.log" 2>&1 &
echo "  Log: ~/.platformgen/install_wizard.log  (PID $!)"
