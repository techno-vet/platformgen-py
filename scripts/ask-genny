#!/usr/bin/env python3
"""Bootstrap the installed Genny CLI from a copied helper script."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def _invoke_adjacent_entrypoint() -> int | None:
    base_dir = Path(__file__).resolve().parent
    if os.name == "nt":
        scripts_dir = base_dir.parent / "venv" / "Scripts"
        candidates = [
            [str(scripts_dir / "genny.exe"), *sys.argv[1:]],
            [
                str(scripts_dir / "python.exe"),
                "-c",
                "from platformgen.cli import genny_main; genny_main()",
                *sys.argv[1:],
            ],
        ]
    else:
        bin_dir = base_dir.parent / "venv" / "bin"
        candidates = [
            [str(bin_dir / "genny"), *sys.argv[1:]],
            [
                str(bin_dir / "python"),
                "-c",
                "from platformgen.cli import genny_main; genny_main()",
                *sys.argv[1:],
            ],
        ]

    for command in candidates:
        if Path(command[0]).exists():
            return subprocess.run(command, check=False).returncode
    return None


def main() -> int:
    rc = _invoke_adjacent_entrypoint()
    if rc is not None:
        return rc

    try:
        from platformgen.cli import genny_main
    except ImportError as exc:
        print(f"❌ Error: could not locate the installed Genny CLI ({exc})", file=sys.stderr)
        return 1

    genny_main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
